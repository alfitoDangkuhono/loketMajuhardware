PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# THERMAL PRINTER (ESC/POS)
# Mode koneksi printer:
#   share   = via Windows share name (butuh sharing diaktifkan)
#   usb     = raw bytes ke port USB langsung (USB001, USB002, ...) - TANPA share
#   com     = tulis ke COM port (COM3, COM4, ...) untuk printer serial
#   network = via TCP ke IP:port printer (port raw umumnya 9100)
#   file    = tulis ke file path (Linux: /dev/usb/lp0)
THERMAL_PRINTER_MODE=share

# Isi sesuai mode:
#   share   -> nama share printer (mis. TM-T82)
#   usb     -> nama port USB (cek di Printer Properties > Ports, mis. USB001)
#   com     -> nama COM port (mis. COM3)
#   network -> IP:port (mis. 192.168.1.50:9100)
#   file    -> path device (mis. /dev/usb/lp0)
# Kosongkan untuk selalu pakai fallback preview browser.
THERMAL_PRINTER_NAME=

# Width paper dalam karakter (umumnya 32 utk 58mm, 48 utk 80mm)
THERMAL_PRINTER_WIDTH=32

